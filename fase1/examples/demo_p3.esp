entero x = 1;
si (verdadero) {
    real x = 2.5;        // shadowing: permitido, solo advertencia
    entero z = 5;
    imprimir(x);
    imprimir(z);
}
imprimir(x);             // vuelve a ser la x entera
entero x = 3;            // ERROR: redeclaración en el mismo ámbito
